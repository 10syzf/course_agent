# =============================================================
# Course Agent 环境变量示例文件
# 使用方法：cp .env.example .env，然后把下方占位符替换成你自己的真实值
# 重要：.env 文件已在 .gitignore 中，绝对不要把真实 Key 提交到仓库！
# =============================================================

# ---------------- LLM 配置 ----------------
# provider 可选值：
#   mock   - 离线规则引擎，无需任何 Key，可用于本地开发/测试
#   openai - 任意 OpenAI 兼容接口（OpenAI 官方 / 阿里云百炼 DashScope / DeepSeek / 字节豆包 Ark / Moonshot 等）
LLM_PROVIDER=openai

# 你的 API Key，请替换为自己的真实值
# 示例占位符（请勿直接使用）：
OPENAI_API_KEY=your-api-key-here

# 不同服务商的 BASE_URL 参考（按实际选择其一）：
#   OpenAI 官方         https://api.openai.com/v1
#   阿里云百炼 DashScope https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek           https://api.deepseek.com/v1
#   字节豆包 Ark        https://ark.cn-beijing.volces.com/api/v3
#   Moonshot Kimi      https://api.moonshot.cn/v1
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 不同服务商的常用模型名参考：
#   DashScope: qwen-plus / qwen-turbo / qwen-max / qwen-long
#   DeepSeek : deepseek-chat / deepseek-reasoner
#   OpenAI   : gpt-4o-mini / gpt-4o
#   豆包 Ark  : 你创建的 endpoint id (如 ep-2024xxxxxx)
OPENAI_MODEL=qwen-plus

# ---------------- Agent 行为参数 ----------------
# Agent 单次对话的最大思考-行动循环步数（防止死循环）
AGENT_MAX_STEPS=8
# 日志级别：DEBUG / INFO / WARNING / ERROR
AGENT_LOG_LEVEL=INFO

# ---------------- 可选：在线测试开关 ----------------
# 设置为 1 才会运行 tests/test_openai_live.py 中的真实 LLM 调用测试
# 默认不设置时会自动跳过这些测试，以免消耗你的 API 额度
# RUN_LIVE_LLM=1

# 设置为 1 才会运行 tests/test_web_tools.py 中的真实 DuckDuckGo / web_fetch 联网测试
# RUN_LIVE_WEB=1

# ---------------- 可选：真实 Web 检索（Task 007） ----------------
# Tavily 是高质量搜索 API（个人免费额度 1000 次/月）。
# 如果不配置，Course Agent 会自动回退到 DuckDuckGo（无需 Key，但质量略差）。
# 申请地址：https://tavily.com
# TAVILY_API_KEY=tvly-your-tavily-key-here

# ---------------- 可选：长期记忆 Embedding（Task 007） ----------------
# 不配置时会自动使用离线 HashEmbedder（256 维，零依赖、可用但语义弱）。
# 配置 OPENAI_API_KEY 后会自动切到 OpenAIEmbedder（1024 维真实语义向量）。
# 也可以单独指定 Embedding 模型（默认跟随 OPENAI_BASE_URL）：
# EMBEDDING_MODEL=text-embedding-v3      # DashScope
# EMBEDDING_MODEL=text-embedding-3-small # OpenAI 官方
